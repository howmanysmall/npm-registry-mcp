{
	"mcpServers": {
		"context7": {
			"args": ["x", "--bun", "@upstash/context7-mcp"],
			"command": "bun",
			"env": {},
			"type": "stdio"
		},
		"gh-grep": {
			"type": "http",
			"url": "https://mcp.grep.app"
		},
		"github": {
			"args": ["x", "--bun", "@modelcontextprotocol/server-github"],
			"command": "bun",
			"env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${CLAUDE_GITHUB_PERSONAL_ACCESS_TOKEN}" }
		},
		"package-registry": {
			"args": ["x", "--bun", "package-registry-mcp"],
			"command": "bun"
		}
	},
	"removed": {
		"npm-registry": {
			"command": "./bin/npm-registry-mcp"
		}
	}
}
